# Copy to .env locally. Never commit real API keys or secrets.

# Your OWN Alpaca PAPER trading keys — generate fresh ones at
# https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Groq free-tier key — https://console.groq.com
GROQ_API_KEY=

# Order safety: dry-run is the default. Do not enable until server-side risk controls
# have been reviewed and tested. These values are intentionally conservative.
TRADING_EXECUTION_ENABLED=false
TRADING_ALLOWED_SYMBOLS=
TRADING_OPTIONS_ENABLED=false
